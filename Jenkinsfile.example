#!/bin/bash
# Jenkins 后置脚本示例：Kea2 / Monkey 稳定性测试报告解析与飞书通知
# Pipeline 参数建议：ENGINE=kea2|monkey, RUNNING_MINUTES, SCENARIOS, DEVICE_ID, PACKAGE_NAME

JENKINS_URL="${JENKINS_URL:-https://jenkins.aeke.net}"
JOB_NAME="${JOB_NAME:-fitness-stability-test}"
VIEW_NAME="${VIEW_NAME:-auto-test}"
ENGINE="${ENGINE:-kea2}"

echo "===== 查找测试报告 (engine=${ENGINE}) ====="

REPORT_JSON=$(find outputs -name "report.json" 2>/dev/null | sort | tail -1)
REPORT_FILE=$(find outputs -name "report.html" 2>/dev/null | sort | tail -1)

if [ -z "$REPORT_FILE" ] && [ -z "$REPORT_JSON" ]; then
    echo "未找到报告文件"
    REPORT_URL="${JENKINS_URL}/view/${VIEW_NAME}/job/${JOB_NAME}/${BUILD_NUMBER}/artifact/outputs/"
else
    if [ -n "$REPORT_FILE" ]; then
        echo "HTML 报告路径: $REPORT_FILE"
        RELATIVE_PATH=${REPORT_FILE#outputs/}
        REPORT_URL="${JENKINS_URL}/view/${VIEW_NAME}/job/${JOB_NAME}/${BUILD_NUMBER}/artifact/outputs/${RELATIVE_PATH}"
    fi
    if [ -n "$REPORT_JSON" ]; then
        echo "JSON 报告路径: $REPORT_JSON"
    fi
fi

if [ -f "$REPORT_FILE" ]; then
    mkdir -p outputs/latest
    cp "$REPORT_FILE" outputs/latest/report.html
fi
if [ -f "$REPORT_JSON" ]; then
    mkdir -p outputs/latest
    cp "$REPORT_JSON" outputs/latest/report.json
fi

echo "===== 从 JSON 解析测试结果 ====="

CRASH_COUNT=0
APP_VERSION="未知"
FIRMWARE_VERSION="未知"
DURATION="未知"
TEST_ENGINE="未知"
GATE_PASSED="true"
GATE_REASONS=""
PROPERTY_VIOLATIONS=0
KEA2_EXIT_CODE=""
CRASH_SUMMARY=""

_parse_json_field() {
    python3 - "$1" "$2" <<'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    val = data
    for part in key.split("."):
        if isinstance(val, dict):
            val = val.get(part)
        else:
            val = None
            break
    if val is None:
        print("")
    elif isinstance(val, (dict, list)):
        print(json.dumps(val, ensure_ascii=False))
    else:
        print(val)
except Exception:
    print("")
PY
}

if [ -f "$REPORT_JSON" ]; then
    CRASH_COUNT=$(_parse_json_field "$REPORT_JSON" "crash_count")
    APP_VERSION=$(_parse_json_field "$REPORT_JSON" "device_version_name")
    FIRMWARE_VERSION=$(_parse_json_field "$REPORT_JSON" "firmware_version")
    DURATION=$(_parse_json_field "$REPORT_JSON" "duration")
    TEST_ENGINE=$(_parse_json_field "$REPORT_JSON" "test_engine")
    GATE_PASSED=$(_parse_json_field "$REPORT_JSON" "gate_status.passed")
    PROPERTY_VIOLATIONS=$(_parse_json_field "$REPORT_JSON" "kea2.property_violation_count")
    KEA2_EXIT_CODE=$(_parse_json_field "$REPORT_JSON" "kea2.exit_code")

    REASONS_JSON=$(_parse_json_field "$REPORT_JSON" "gate_status.reasons")
    if [ -n "$REASONS_JSON" ] && [ "$REASONS_JSON" != "[]" ]; then
        GATE_REASONS=$(python3 - "$REPORT_JSON" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    reasons = (json.load(f).get("gate_status") or {}).get("reasons") or []
print("\\n".join(reasons))
PY
)
    fi

    CATEGORIES=$(_parse_json_field "$REPORT_JSON" "log_analysis.crash_categories")
    if [ -n "$CATEGORIES" ] && [ "$CATEGORIES" != "{}" ]; then
        CRASH_SUMMARY=$(python3 - "$REPORT_JSON" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
cats = (data.get("log_analysis") or {}).get("crash_categories") or {}
print("\\n".join(f"{k}: {v}次" for k, v in cats.items()))
PY
)
    fi
fi

CRASH_COUNT=${CRASH_COUNT:-0}
PROPERTY_VIOLATIONS=${PROPERTY_VIOLATIONS:-0}
TEST_ENGINE=${TEST_ENGINE:-$ENGINE}

echo "测试引擎: $TEST_ENGINE"
echo "崩溃次数: $CRASH_COUNT"
echo "属性违反: $PROPERTY_VIOLATIONS"
echo "Kea2 退出码: $KEA2_EXIT_CODE"
echo "门禁通过: $GATE_PASSED"
echo "应用版本: $APP_VERSION"

echo "===== 发送飞书通知 ====="

if [ "$GATE_PASSED" = "True" ] || [ "$GATE_PASSED" = "true" ]; then
    TEST_STATUS="✅ 通过"
    CARD_COLOR="green"
else
    TEST_STATUS="❌ 失败"
    CARD_COLOR="red"
    if [ -n "$GATE_REASONS" ]; then
        TEST_STATUS="❌ 失败（${GATE_REASONS//$'\n'/；}）"
    fi
fi

EXEC_LABEL="${RUNNING_MINUTES:-N/A} 分钟"
if [ "$TEST_ENGINE" = "monkey" ]; then
    EXEC_LABEL="${EVENT_COUNT:-N/A} 事件"
fi

JSON=$(cat <<EOF
{
  "msg_type": "interactive",
  "card": {
    "header": {
      "title": {
        "tag": "plain_text",
        "content": "力量镜稳定性测试报告 (${TEST_ENGINE})"
      },
      "template": "${CARD_COLOR}"
    },
    "elements": [
      {
        "tag": "div",
        "fields": [
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**构建编号**\\n${BUILD_NUMBER}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**测试结果**\\n${TEST_STATUS}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**测试引擎**\\n${TEST_ENGINE}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**应用包名**\\n${PACKAGE_NAME}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**应用版本**\\n${APP_VERSION}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**崩溃 / 属性违反**\\n${CRASH_COUNT} / ${PROPERTY_VIOLATIONS}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**执行规模 / 时长**\\n${EXEC_LABEL} / ${DURATION}" }
          }
        ]
      },
      {
        "tag": "action",
        "actions": [
          {
            "tag": "button",
            "text": { "tag": "plain_text", "content": "查看详细报告" },
            "type": "primary",
            "url": "${REPORT_URL}"
          }
        ]
      }
    ]
  }
}
EOF
)

MAX_RETRY=3
RETRY_INTERVAL=15

for i in $(seq 1 $MAX_RETRY); do
    RESPONSE=$(curl -s -X POST \
      -H "Content-Type: application/json" \
      -d "$JSON" \
      "${FEISHU_WEBHOOK_URL:-https://open.feishu.cn/open-apis/bot/v2/hook/a13b2176-4f1f-4cb5-a88e-e656abc9f25f}")

    echo "飞书响应: $RESPONSE"
    CODE=$(echo "$RESPONSE" | grep -Eo '"code":[0-9]+' | grep -Eo '[0-9]+')
    if [ "$CODE" = "0" ] || [ -z "$CODE" ]; then
        echo "飞书通知发送成功"
        break
    elif [ "$CODE" = "11232" ]; then
        echo "触发频率限制，${RETRY_INTERVAL}秒后重试（第${i}次）..."
        sleep $RETRY_INTERVAL
    else
        echo "发送失败，code=${CODE}"
        break
    fi
done

echo ""
echo "===== Jenkins 门禁 ====="
if [ "$GATE_PASSED" = "True" ] || [ "$GATE_PASSED" = "true" ]; then
    echo "门禁通过"
    exit 0
else
    echo "门禁失败"
    exit 1
fi

#!/bin/bash

JENKINS_URL="https://jenkins.aeke.net"
JOB_NAME="monkey-auto-test"
VIEW_NAME="auto-test"

echo "===== 查找测试报告 ====="

REPORT_FILE=$(find outputs -name "*.html" | sort | tail -1)

if [ -z "$REPORT_FILE" ]; then
    echo "未找到报告文件"
    REPORT_URL="${JENKINS_URL}/view/${VIEW_NAME}/job/${JOB_NAME}/${BUILD_NUMBER}/artifact/outputs/"
else
    echo "报告路径: $REPORT_FILE"
    RELATIVE_PATH=${REPORT_FILE#outputs/}
    REPORT_URL="${JENKINS_URL}/view/${VIEW_NAME}/job/${JOB_NAME}/${BUILD_NUMBER}/artifact/outputs/${RELATIVE_PATH}"
fi

# 复制报告到固定路径，供 HTML Publisher 使用（避免通配符问题）
if [ -f "$REPORT_FILE" ]; then
    mkdir -p outputs/latest
    cp "$REPORT_FILE" outputs/latest/report.html
fi

echo "===== 解析崩溃次数 ====="

CRASH_COUNT=0

if [ -f "$REPORT_FILE" ]; then
    # 从 HTML div 结构中提取崩溃次数（兼容内联样式格式）
    CRASH_COUNT=$(grep -A2 "崩溃次数" "$REPORT_FILE" | grep -Eo ">[0-9]+<" | grep -Eo "[0-9]+" | head -1)
    if [ -z "$CRASH_COUNT" ]; then
        CRASH_COUNT=0
    fi
fi

echo "崩溃次数: $CRASH_COUNT"

echo "===== 获取应用版本 ====="

APP_VERSION=""

if [ -f "$REPORT_FILE" ]; then
    # 从 HTML div 结构中提取应用版本（兼容内联样式格式）
    APP_VERSION=$(grep -A2 "应用版本" "$REPORT_FILE" | grep -Eo ">[0-9]+(\.[0-9]+)+<" | grep -Eo "[0-9]+(\.[0-9]+)+" | head -1)
fi

if [ -z "$APP_VERSION" ]; then
    APP_VERSION="未知"
fi

echo "应用版本: $APP_VERSION"

echo "===== 获取主板固件 ====="

FIRMWARE_VERSION=""

if [ -f "$REPORT_FILE" ]; then
    FIRMWARE_VERSION=$(grep "主板固件" "$REPORT_FILE" | grep -Eo "<td[^>]*>[^<]+</td>" | tail -1 | sed 's/<[^>]*>//g' | tr -d ' ')
fi

if [ -z "$FIRMWARE_VERSION" ]; then
    FIRMWARE_VERSION="未知"
fi

echo "主板固件: $FIRMWARE_VERSION"

echo "===== 获取测试时长 ====="

DURATION=""
if [ -f "$REPORT_FILE" ]; then
    # 时长在"测试时长"标签前面的div里，格式如 ">12秒<"
    DURATION=$(grep -B2 "测试时长" "$REPORT_FILE" | grep -Eo ">[0-9]+秒<" | grep -Eo "[0-9]+秒" | head -1)
fi
if [ -z "$DURATION" ]; then
    DURATION="未知"
fi
echo "测试时长: $DURATION"

echo "===== 获取崩溃分类 ====="

CRASH_SUMMARY=""
if [ -f "$REPORT_FILE" ] && [ "$CRASH_COUNT" -gt 0 ]; then
    # 提取崩溃分类，每条用 \n 分隔（飞书 lark_md 换行符）
    CRASH_SUMMARY=$(grep -Eo '[A-Za-z]+Exception: [0-9]+次|ANR: [0-9]+次|Other: [0-9]+次' "$REPORT_FILE" | head -5 | awk '{printf "%s\\n", $0}' | sed 's/\\n$//')
fi

echo "===== 发送飞书通知 ====="

# 根据崩溃次数设置状态和卡片颜色
if [ "$CRASH_COUNT" -eq 0 ]; then
    TEST_STATUS="✅ 通过"
    CARD_COLOR="green"
else
    TEST_STATUS="❌ 失败（崩溃 ${CRASH_COUNT} 次）"
    CARD_COLOR="red"
fi

JSON=$(cat <<EOF
{
  "msg_type": "interactive",
  "card": {
    "header": {
      "title": {
        "tag": "plain_text",
        "content": "Monkey 稳定性测试报告"
      },
      "template": "${CARD_COLOR}"
    },
    "elements": [
      {
        "tag": "div",
        "fields": [
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**构建编号**\n${BUILD_NUMBER}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**测试结果**\n${TEST_STATUS}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**应用包名**\n${PACKAGE_NAME}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**应用版本**\n${APP_VERSION}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**主板固件**\n${FIRMWARE_VERSION}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**设备ID**\n${DEVICE_ID}" }
          },
          {
            "is_short": true,
            "text": { "tag": "lark_md", "content": "**事件数量 / 时长**\n${EVENT_COUNT} 次 / ${DURATION}" }
          }
          $([ -n "$CRASH_SUMMARY" ] && echo ",{\"is_short\": false, \"text\": { \"tag\": \"lark_md\", \"content\": \"**崩溃分类**\\n${CRASH_SUMMARY}\" }}")
        ]
      },
      {
        "tag": "action",
        "actions": [
          {
            "tag": "button",
            "text": { "tag": "plain_text", "content": "查看详细报告" },
            "type": "primary",
            "url": "${REPORT_URL}"
          }
        ]
      }
    ]
  }
}
EOF
)

curl -s -X POST \
  -H "Content-Type: application/json" \
  -d "$JSON" \
  https://open.feishu.cn/open-apis/bot/v2/hook/a13b2176-4f1f-4cb5-a88e-e656abc9f25f

echo ""
echo "===== 完成 ====="
